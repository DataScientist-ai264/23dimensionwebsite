# Environment Variables for Direct Email# Supabase Configuration

# Add these to your Vercel project settingsSUPABASE_URL=your_supabase_project_url_here

SUPABASE_ANON_KEY=your_supabase_anon_key_here

GMAIL_USER=your-email@gmail.com

GMAIL_APP_PASSWORD=your-16-character-app-password# Example:

CONTACT_EMAIL=your-email@gmail.com# SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Example:
# GMAIL_USER=contact@2plus3dimension.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# CONTACT_EMAIL=contact@2plus3dimension.com

# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication
# 3. Go to App Passwords
# 4. Generate password for "Mail"
# 5. Copy the 16-character password